/* ===== HEADER ===== */
.site-header {
  width: 1168px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* --- Верхняя строка --- */
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
  gap: 32px;
  padding: 0;
}

.header-top .logo {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.header-top .logo img {
  width: 56px;
  height: 56px;
}

/* Поиск */
.header-search {
  display: flex;
  align-items: center;
  gap: 4px;
  width: 200px;
  height: 48px;
  padding: 0 16px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  border: none;
}

.header-search .search-icon {
  color: rgba(255, 255, 255, 0.64);
  flex-shrink: 0;
}

.header-search input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #FFFFFF;
  font-family: "Suisse Intl";
  font-size: 16px;
  line-height: 24px;
}

.header-search input::placeholder {
  color: rgba(255, 255, 255, 0.64);
}

/* Переключатель языка */
.lang-selector {
  display: flex;
  align-items: center;
  gap: 4px;
  background: transparent;
  border: none;
  color: #FFFFFF;
  font-family: "Suisse Intl";
  font-size: 16px;
  line-height: 24px;
  cursor: pointer;
  padding: 8px;
}

.lang-selector .globe-icon,
.lang-selector .chevron {
  color: #FFFFFF;
}

/* Кнопки */
.button-secondary {
  height: 48px;
  padding: 12px 28px;
  background: rgba(255, 255, 255, 0.12);
  border: none;
  border-radius: 12px;
  color: #FFFFFF;
  font-family: "Suisse Intl";
  font-size: 16px;
  font-weight: 500;
  line-height: 24px;
  cursor: pointer;
}

.button-secondary:hover {
  background: rgba(255, 255, 255, 0.18);
}

.button-primary {
  width: 190px;
  height: 48px;
  padding: 12px 16px;
  background: #12951A;
  border: none;
  border-radius: 12px;
  color: #FFFFFF;
  font-family: "Suisse Intl";
  font-size: 16px;
  font-weight: 500;
  line-height: 24px;
  cursor: pointer;
}

.button-primary:hover {
  background: #19AA1E;
}

.button-primary:active {
  background: #00830C;
}

/* --- Навигационная панель --- */
.header-nav {
  display: flex;
  align-items: center;
  gap: 32px;
  height: 80px;
  padding: 0 28px;
  background: #283136;
  border-radius: 16px;
  margin-top: 0;
}

.nav-dropdown {
  display: flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: none;
  color: #FFFFFF;
  font-family: "Suisse Intl";
  font-size: 16px;
  font-weight: 400;
  line-height: 24px;
  cursor: pointer;
  padding: 0;
}

.nav-dropdown .chevron {
  color: #FFFFFF;
}

.header-nav a {
  color: rgba(255, 255, 255, 0.64);
  font-family: "Suisse Intl";
  font-size: 16px;
  font-weight: 400;
  line-height: 24px;
  text-decoration: none;
}

.header-nav a:hover {
  color: #FFFFFF;
}